{
  "apiVersion": 1,
  "name": "ailog",
  "binary": "ailog",
  "short": "View and search system logs",
  "order": 20,
  "usage": "ailog [flags] [keywords...]",
  "flags": [
    {
      "name": "json",
      "type": "bool",
      "help": "NDJSON output"
    },
    {
      "name": "follow",
      "short": "f",
      "type": "bool",
      "help": "follow log stream"
    },
    {
      "name": "expr",
      "type": "string",
      "help": "boolean expression filter"
    },
    {
      "name": "help",
      "short": "h",
      "type": "bool",
      "help": "help for ailog"
    }
  ],
  "examples": [
    "ailog search error",
    "ailog --json search kernel",
    "ailog sources"
  ]
}
