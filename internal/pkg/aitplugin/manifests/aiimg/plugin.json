{
  "apiVersion": 1,
  "name": "aiimg",
  "binary": "aiimg",
  "short": "Extract image metadata (EXIF, GPS, device)",
  "order": 30,
  "usage": "aiimg [flags] <image-path>",
  "flags": [
    {
      "name": "json",
      "type": "bool",
      "help": "JSON output"
    },
    {
      "name": "geocode",
      "type": "bool",
      "help": "reverse-geocode GPS coordinates"
    },
    {
      "name": "help",
      "short": "h",
      "type": "bool",
      "help": "help for aiimg"
    }
  ],
  "examples": [
    "aiimg photo.jpg",
    "aiimg --json photo.jpg",
    "aiimg --geocode photo.jpg"
  ]
}
